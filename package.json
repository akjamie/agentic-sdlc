{
  "name": "@akjamie/agentic-sdlc",
  "version": "1.0.0",
  "description": "Enterprise Agentic SDLC governance CLI: a 7-stage spec-driven flow on top of OpenSpec + Graphify, enforced by CI.",
  "type": "module",
  "bin": {
    "asdlc": "bin/asdlc.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akjamie/agentic-sdlc.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "node --check bin/asdlc.js"
  },
  "keywords": [
    "openspec",
    "sdlc",
    "spec-driven-development",
    "agentic",
    "governance"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.6.1"
  }
}
